@model List<WorkOrder>
@{
    ViewData["Title"] = "Work Orders";
    var currentStatus = ViewBag.CurrentStatus as WorkOrderStatus?;
    var currentPriority = ViewBag.CurrentPriority as WorkOrderPriority?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Maintenance Work Orders</h3>
        <p class="text-muted small mb-0">Manage diagnostic tasks, approvals, and field technician dispatching</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="InspectionWizard" asp-action="Step1" class="btn btn-outline-primary">
            <i class="bi bi-magic me-1"></i> Multi-Step Wizard
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> New Work Order
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <select name="status" class="form-select">
                <option value="">-- All Statuses --</option>
                <option value="0" selected="@(currentStatus == WorkOrderStatus.Draft)">Draft</option>
                <option value="1" selected="@(currentStatus == WorkOrderStatus.Submitted)">Submitted (Pending Approval)</option>
                <option value="2" selected="@(currentStatus == WorkOrderStatus.Approved)">Approved</option>
                <option value="3" selected="@(currentStatus == WorkOrderStatus.InProgress)">In Progress</option>
                <option value="4" selected="@(currentStatus == WorkOrderStatus.OnHold)">On Hold</option>
                <option value="5" selected="@(currentStatus == WorkOrderStatus.Completed)">Completed</option>
                <option value="6" selected="@(currentStatus == WorkOrderStatus.Cancelled)">Cancelled</option>
            </select>
        </div>
        <div class="col-md-5">
            <select name="priority" class="form-select">
                <option value="">-- All Priorities --</option>
                <option value="0" selected="@(currentPriority == WorkOrderPriority.Low)">Low</option>
                <option value="1" selected="@(currentPriority == WorkOrderPriority.Medium)">Medium</option>
                <option value="2" selected="@(currentPriority == WorkOrderPriority.High)">High</option>
                <option value="3" selected="@(currentPriority == WorkOrderPriority.Emergency)">Emergency</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i> Apply</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Work Orders Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th>WO Number</th>
                    <th>Title & Equipment</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Created By</th>
                    <th>Technician</th>
                    <th>Scheduled</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center py-4 text-muted">No maintenance orders found.</td></tr>
                }
                else
                {
                    @foreach (var wo in Model)
                    {
                        <tr>
                            <td class="font-monospace fw-bold">@wo.WorkOrderNumber</td>
                            <td>
                                <div class="fw-semibold">@wo.Title</div>
                                <div class="small text-muted">
                                    <i class="bi bi-cpu"></i> @wo.Asset?.Name (@wo.Asset?.AssetTag)
                                </div>
                            </td>
                            <td>
                                @if (wo.Priority == WorkOrderPriority.Emergency) { <span class="badge badge-soft-danger"><i class="bi bi-lightning-fill"></i> Emergency</span> }
                                else if (wo.Priority == WorkOrderPriority.High) { <span class="badge badge-soft-warning">High</span> }
                                else if (wo.Priority == WorkOrderPriority.Medium) { <span class="badge badge-soft-info">Medium</span> }
                                else { <span class="badge badge-soft-secondary">Low</span> }
                            </td>
                            <td>
                                @if (wo.Status == WorkOrderStatus.InProgress) { <span class="badge bg-primary">In Progress</span> }
                                else if (wo.Status == WorkOrderStatus.Submitted) { <span class="badge bg-warning text-dark">Pending Approval</span> }
                                else if (wo.Status == WorkOrderStatus.Approved) { <span class="badge bg-info text-dark">Approved</span> }
                                else if (wo.Status == WorkOrderStatus.Completed) { <span class="badge bg-success">Completed</span> }
                                else { <span class="badge bg-secondary">@wo.Status</span> }
                            </td>
                            <td class="small">@(wo.CreatedBy?.FullName ?? "N/A")</td>
                            <td class="small">@(wo.AssignedTechnician?.FullName ?? "<Unassigned>")</td>
                            <td class="small text-muted">@(wo.ScheduledDate?.ToString("yyyy-MM-dd") ?? "Immediate")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@wo.Id" class="btn btn-sm btn-outline-primary">
                                    Manage <i class="bi bi-chevron-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
