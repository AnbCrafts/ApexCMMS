@model WorkOrder
@{
    ViewData["Title"] = $"{Model.WorkOrderNumber} - Details";
    var technicians = ViewBag.Technicians as SelectList;
    var availableSpareParts = ViewBag.SpareParts as List<SparePart> ?? new List<SparePart>();
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2"><i class="bi bi-arrow-left"></i> Back to Work Orders</a>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h3 class="fw-bold text-dark mb-0 font-monospace">@Model.WorkOrderNumber</h3>
                @if (Model.Status == WorkOrderStatus.InProgress) { <span class="badge bg-primary fs-6">In Progress</span> }
                else if (Model.Status == WorkOrderStatus.Submitted) { <span class="badge bg-warning text-dark fs-6">Pending Approval</span> }
                else if (Model.Status == WorkOrderStatus.Approved) { <span class="badge bg-info text-dark fs-6">Approved</span> }
                else if (Model.Status == WorkOrderStatus.Completed) { <span class="badge bg-success fs-6">Completed</span> }
                else { <span class="badge bg-secondary fs-6">@Model.Status</span> }
            </div>
            <p class="text-muted small mb-0 mt-1">@Model.Title</p>
        </div>

        <!-- Workflow Action Buttons -->
        <div class="d-flex gap-2">
            @if (Model.Status == WorkOrderStatus.Submitted && (User.IsInRole("SuperAdmin") || User.IsInRole("OperationsManager")))
            {
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i> Approve Order
                    </button>
                </form>
            }

            @if (Model.Status == WorkOrderStatus.Approved)
            {
                <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="newStatus" value="InProgress" />
                    <button type="submit" class="btn btn-primary fw-semibold">
                        <i class="bi bi-play-circle me-1"></i> Start Execution
                    </button>
                </form>
            }

            @if (Model.Status == WorkOrderStatus.InProgress)
            {
                <button type="button" class="btn btn-success fw-semibold" data-bs-toggle="modal" data-bs-target="#completeModal">
                    <i class="bi bi-flag-fill me-1"></i> Finalize & Complete
                </button>
            }

            <button type="button" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#allocatePartModal">
                <i class="bi bi-box-seam me-1"></i> Add Spare Part
            </button>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Summary Details Card -->
    <div class="col-lg-8">
        <div class="card p-4 mb-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2">Diagnostic Scope & Equipment Info</h5>
            <div class="row g-3 small">
                <div class="col-sm-6">
                    <span class="text-muted d-block">Target Equipment:</span>
                    <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId" class="fw-bold fs-6 text-decoration-none">
                        @Model.Asset?.Name <span class="badge bg-light text-muted border font-monospace">@Model.Asset?.AssetTag</span>
                    </a>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Facility Department:</span>
                    <span class="fw-semibold">@Model.Asset?.Department?.Name</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Assigned Lead Technician:</span>
                    <span class="fw-semibold">@(Model.AssignedTechnician?.FullName ?? "Unassigned")</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Requester:</span>
                    <span class="fw-semibold">@(Model.CreatedBy?.FullName ?? "System")</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Estimated Labor:</span>
                    <span class="fw-semibold">@Model.EstimatedHours hours</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Actual Labor Incurred:</span>
                    <span class="fw-semibold text-primary">@(Model.ActualHours.HasValue ? $"{Model.ActualHours.Value} hours" : "Ongoing")</span>
                </div>
                <div class="col-12 mt-3">
                    <span class="text-muted d-block">Detailed Work Instructions:</span>
                    <div class="bg-light p-3 rounded mt-1" style="white-space: pre-wrap;">@Model.Description</div>
                </div>
            </div>
        </div>

        <!-- Checklist Section -->
        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                <h5 class="fw-bold mb-0">Step-by-Step Maintenance Checklist</h5>
                <span class="badge bg-light text-primary border">
                    @Model.ChecklistItems.Count(c => c.IsCompleted) / @Model.ChecklistItems.Count Completed
                </span>
            </div>

            @if (Model.ChecklistItems.Count == 0)
            {
                <div class="text-muted text-center py-3">No checklist steps assigned.</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var step in Model.ChecklistItems)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <div class="d-flex align-items-start gap-3">
                                <form asp-action="ToggleChecklistItem" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="checklistItemId" value="@step.Id" />
                                    <input type="hidden" name="workOrderId" value="@Model.Id" />
                                    <input type="hidden" name="isCompleted" value="@(!step.IsCompleted ? "true" : "false")" />
                                    <button type="submit" class="btn btn-sm @(step.IsCompleted ? "btn-success" : "btn-outline-secondary") rounded-circle p-1" style="width: 28px; height: 28px;" title="Toggle Step">
                                        <i class="bi bi-check"></i>
                                    </button>
                                </form>
                                <div>
                                    <div class="fw-semibold @(step.IsCompleted ? "text-decoration-line-through text-muted" : "text-dark")">
                                        <span class="text-muted me-1">#@step.StepNumber</span> @step.Description
                                    </div>
                                    @if (!string.IsNullOrEmpty(step.Notes))
                                    {
                                        <div class="small text-muted fst-italic mt-1"><i class="bi bi-journal"></i> @step.Notes</div>
                                    }
                                </div>
                            </div>

                            @if (step.IsCompleted)
                            {
                                <div class="text-end small">
                                    <span class="badge badge-soft-success"><i class="bi bi-check2"></i> Done</span>
                                    <div class="text-muted" style="font-size: 0.7rem;">@step.CompletedAtUtc?.ToString("MMM dd, HH:mm")</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Parts Consumed & Timeline Card -->
    <div class="col-lg-4">
        <!-- Allocated Parts Card -->
        <div class="card p-3 mb-4">
            <h6 class="fw-bold text-dark mb-3">Allocated Spare Parts</h6>
            @if (Model.PartAllocations.Count == 0)
            {
                <div class="text-muted small text-center py-3">No spare parts allocated yet.</div>
            }
            else
            {
                <ul class="list-group list-group-flush small mb-3">
                    @foreach (var part in Model.PartAllocations)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <div class="fw-semibold">@part.SparePart?.Name</div>
                                <div class="text-muted">@part.QuantityUsed x $@part.UnitPriceAtUsage.ToString("F2")</div>
                            </div>
                            <span class="fw-bold font-monospace">$@((part.QuantityUsed * part.UnitPriceAtUsage).ToString("F2"))</span>
                        </li>
                    }
                </ul>
                <div class="border-top pt-2 d-flex justify-content-between fw-bold">
                    <span>Total Parts Cost:</span>
                    <span class="text-primary font-monospace">$@(Model.PartAllocations.Sum(p => p.QuantityUsed * p.UnitPriceAtUsage).ToString("F2"))</span>
                </div>
            }
        </div>

        <!-- Audit & State Timestamps -->
        <div class="card p-3">
            <h6 class="fw-bold text-dark mb-3">Lifecycle Timestamps</h6>
            <ul class="list-unstyled small text-muted mb-0">
                <li class="mb-2"><strong>Created:</strong> @Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</li>
                @if (Model.ScheduledDate.HasValue)
                {
                    <li class="mb-2"><strong>Scheduled:</strong> @Model.ScheduledDate.Value.ToString("yyyy-MM-dd")</li>
                }
                @if (Model.CompletedAtUtc.HasValue)
                {
                    <li class="mb-2 text-success"><strong>Completed:</strong> @Model.CompletedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC</li>
                }
            </ul>
        </div>
    </div>
</div>

<!-- Modal: Allocate Spare Part -->
<div class="modal fade" id="allocatePartModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="SpareParts" asp-action="Allocate" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="WorkOrderId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Allocate Spare Part</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Select Spare Part</label>
                        <select name="SparePartId" class="form-select" required>
                            @foreach (var part in availableSpareParts)
                            {
                                <option value="@part.Id">@part.Name (@part.PartNumber) - In Stock: @part.QuantityOnHand ($@part.UnitPrice)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Quantity to Deduct</label>
                        <input type="number" name="Quantity" class="form-control" value="1" min="1" max="100" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Allocate & Deduct Inventory</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Complete Work Order -->
<div class="modal fade" id="completeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="newStatus" value="Completed" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Finalize Work Order</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted">
                        Marking this order as <strong>Completed</strong> will update the equipment status back to <strong>Operational</strong>.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Final Actual Labor Hours</label>
                        <input type="number" step="0.25" name="actualHours" class="form-control" value="@(Model.ActualHours ?? Model.EstimatedHours)" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Confirm Completion</button>
                </div>
            </form>
        </div>
    </div>
</div>
