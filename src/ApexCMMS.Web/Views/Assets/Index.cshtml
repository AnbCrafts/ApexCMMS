@model List<Asset>
@{
    ViewData["Title"] = "Equipment Registry";
    var categories = ViewBag.Categories as SelectList;
    var currentStatus = ViewBag.CurrentStatus as AssetStatus?;
    var search = ViewBag.Search as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Equipment & Asset Registry</h3>
        <p class="text-muted small mb-0">Track and monitor all facility physical infrastructure</p>
    </div>
    @if (User.IsInRole("SuperAdmin") || User.IsInRole("OperationsManager"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Register Equipment
        </a>
    }
</div>

<!-- Search & Filter Card -->
<div class="card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <input type="text" name="search" value="@search" class="form-control" placeholder="Search by Tag, Name, Serial #..." />
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select" asp-items="categories">
                <option value="">-- All Categories --</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">-- All Statuses --</option>
                <option value="0" selected="@(currentStatus == AssetStatus.Operational)">Operational</option>
                <option value="1" selected="@(currentStatus == AssetStatus.Degraded)">Degraded</option>
                <option value="2" selected="@(currentStatus == AssetStatus.UnderMaintenance)">Under Maintenance</option>
                <option value="3" selected="@(currentStatus == AssetStatus.Decommissioned)">Decommissioned</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Assets Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th>Tag</th>
                    <th>Equipment Name</th>
                    <th>Category</th>
                    <th>Department</th>
                    <th>Criticality</th>
                    <th>Status</th>
                    <th>Active Orders</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No equipment found matching criteria.</td>
                    </tr>
                }
                else
                {
                    @foreach (var asset in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border font-monospace">@asset.AssetTag</span></td>
                            <td>
                                <div class="fw-semibold">@asset.Name</div>
                                @if (!string.IsNullOrEmpty(asset.SerialNumber))
                                {
                                    <span class="text-muted small">SN: @asset.SerialNumber</span>
                                }
                            </td>
                            <td>@asset.Category?.Name</td>
                            <td>@asset.Department?.Name</td>
                            <td>
                                @if (asset.Criticality == AssetCriticality.MissionCritical) { <span class="badge badge-soft-danger">Mission Critical</span> }
                                else if (asset.Criticality == AssetCriticality.High) { <span class="badge badge-soft-warning">High</span> }
                                else if (asset.Criticality == AssetCriticality.Medium) { <span class="badge badge-soft-info">Medium</span> }
                                else { <span class="badge badge-soft-secondary">Low</span> }
                            </td>
                            <td>
                                @if (asset.Status == AssetStatus.Operational) { <span class="badge bg-success">Operational</span> }
                                else if (asset.Status == AssetStatus.UnderMaintenance) { <span class="badge bg-warning text-dark">In Maintenance</span> }
                                else if (asset.Status == AssetStatus.Degraded) { <span class="badge bg-danger">Degraded</span> }
                                else { <span class="badge bg-secondary">Decommissioned</span> }
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border">@asset.WorkOrders.Count(w => w.Status != WorkOrderStatus.Completed && w.Status != WorkOrderStatus.Cancelled) active</span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@asset.Id" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("OperationsManager"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@asset.Id" class="btn btn-outline-primary" title="Edit Equipment">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
