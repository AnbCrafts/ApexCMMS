                        <tr><td>Compliance Audit Trail</td><td><span class="badge bg-success">Full Access</span></td><td><span class="badge bg-danger">No</span></td><td><span class="badge bg-danger">No</span></td><td><span class="badge bg-success">Full Access</span></td></tr>
