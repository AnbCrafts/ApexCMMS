                        <tr><td>Equipment Registry Access</td><td><span class="badge bg-primary">Global</span></td><td><span class="badge bg-info text-dark">Department Match</span></td><td><span class="badge bg-info text-dark">Department Match</span></td><td><span class="badge bg-secondary">Read-Only</span></td></tr>
                        <tr><td>Work Order Approval</td><td><span class="badge bg-success">Yes</span></td><td><span class="badge bg-success">Yes</span></td><td><span class="badge bg-danger">No</span></td><td><span class="badge bg-danger">No</span></td></tr>
