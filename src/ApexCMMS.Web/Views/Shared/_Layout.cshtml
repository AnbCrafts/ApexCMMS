<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ApexCMMS Enterprise</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root {
            --sidebar-width: 260px;
            --brand-primary: #0f172a;
            --brand-accent: #2563eb;
            --sidebar-bg: #1e293b;
        }
        body {
            background-color: #f8fafc;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #334155;
        }
        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
            color: #94a3b8;
        }
        .sidebar .brand {
            padding: 1.25rem 1.5rem;
            color: #fff;
            font-weight: 700;
            font-size: 1.25rem;
            border-bottom: 1px solid #334155;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .sidebar .nav-link {
            color: #94a3b8;
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all 0.2s ease;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: #ffffff;
            background-color: #0f172a;
            border-left-color: var(--brand-accent);
        }
        .sidebar .nav-section-title {
            padding: 1rem 1.5rem 0.25rem;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            font-weight: 700;
        }
        .main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .top-navbar {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.75rem 1.5rem;
        }
        .content-area {
            padding: 2rem 1.5rem;
            flex: 1;
        }
        .card {
            border: 1px solid #e2e8f0;
            border-radius: 0.75rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        }
        .badge-soft-success { background: #dcfce7; color: #166534; }
        .badge-soft-warning { background: #fef9c3; color: #854d0e; }
        .badge-soft-danger { background: #fee2e2; color: #991b1b; }
        .badge-soft-info { background: #e0f2fe; color: #075985; }
        .badge-soft-secondary { background: #f1f5f9; color: #475569; }
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="brand">
                <i class="bi bi-shield-check text-primary"></i>
                <span>ApexCMMS</span>
            </div>

            <nav class="nav flex-column mt-3">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i> Dashboard
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Architecture" ? "active" : "")" asp-controller="Dashboard" asp-action="Architecture">
                    <i class="bi bi-journal-code"></i> Architecture Guide
                </a>

                <div class="nav-section-title">Maintenance</div>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Assets" ? "active" : "")" asp-controller="Assets" asp-action="Index">
                    <i class="bi bi-cpu"></i> Equipment Assets
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "WorkOrders" ? "active" : "")" asp-controller="WorkOrders" asp-action="Index">
                    <i class="bi bi-clipboard2-check"></i> Work Orders
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "InspectionWizard" ? "active" : "")" asp-controller="InspectionWizard" asp-action="Step1">
                    <i class="bi bi-magic"></i> Inspection Wizard
                </a>

                <div class="nav-section-title">Warehouse</div>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SpareParts" ? "active" : "")" asp-controller="SpareParts" asp-action="Index">
                    <i class="bi bi-box-seam"></i> Spare Parts
                </a>

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("SafetyAuditor"))
                {
                    <div class="nav-section-title">Security & Governance</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Audit" ? "active" : "")" asp-controller="Audit" asp-action="Index">
                        <i class="bi bi-journal-text"></i> Audit Trail
                    </a>
                }
            </nav>
        </aside>

        <!-- Main Wrapper -->
        <div class="main-wrapper">
            <!-- Top Navbar -->
            <header class="top-navbar d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-secondary">System: Active</span>
                    <span class="text-muted small">Server Time: @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm") UTC</span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="text-end">
                        <div class="fw-semibold small">@User.Identity.Name</div>
                        <div class="text-muted" style="font-size: 0.75rem;">
                            @if (User.IsInRole("SuperAdmin")) { <span class="badge badge-soft-danger">SuperAdmin</span> }
                            else if (User.IsInRole("OperationsManager")) { <span class="badge badge-soft-warning">Manager</span> }
                            else if (User.IsInRole("FieldTechnician")) { <span class="badge badge-soft-info">Technician</span> }
                            else if (User.IsInRole("SafetyAuditor")) { <span class="badge badge-soft-secondary">Auditor</span> }
                        </div>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Sign Out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </header>

            <!-- Main Content Area -->
            <main class="content-area">
                <!-- Flash Notification Banners -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                        <div>@TempData["InfoMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <!-- Anonymous Layout (Login/Access Denied) -->
        <main class="min-vh-100 d-flex flex-column justify-content-center align-items-center p-3">
            @RenderBody()
        </main>
    }

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
